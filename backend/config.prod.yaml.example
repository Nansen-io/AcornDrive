server:
  port: 8080
  baseURL: "/"
  externalUrl: "https://drive.acorn.tools"
  sources:
    - path: "/srv"
      name: "joliroDrive"
      config:
        defaultEnabled: true
        defaultUserScope: "/users"
        createUserDir: true

auth:
  key: "__AUTH_KEY__" # MUST be exactly 32 bytes for AES-256
  tokenExpirationHours: 8
  methods:
    chainfs:
      enabled: true
      # DEV client (ae8e4cce) is a PUBLIC client — auth-code + PKCE needs no secret.
      clientSecret: ""
      createUser: true
      adminClaim: "roles"
      adminClaimValue: "admin"

      # --- Identity + Storage: DEV (nansendev2 B2C + nansendev ChainFS) ------------------------
      # The whole working stack — Diary and the hub's ChainFS provisioning — runs on DEV, so Drive
      # runs on DEV too, on the SAME ChainFS the provisioning writes to. (Confirmed live: Diary
      # logs in at nansendev2; the hub provisions via the dev ChainFS API's PATCH method.)
      # Consolidating everything onto a single prod directory is a later, separate migration.
      #
      # Policy B2C_1_signupsignin1 (same as Diary). Drive upgrades this to auth-code + PKCE at
      # runtime and appends offline_access.
      loginUrl: "https://nansendev2.b2clogin.com/NansenDEV2.onmicrosoft.com/B2C_1_signupsignin1/oauth2/v2.0/authorize?client_id=ae8e4cce-f313-459b-b86b-2fa59b4f1cb8&scope=openid+profile+https%3A%2F%2FNansenDEV2.onmicrosoft.com%2Ftasks-api%2Faccess_as_user"
      tokenUrl: "https://nansendev2.b2clogin.com/NansenDEV2.onmicrosoft.com/B2C_1_signupsignin1/oauth2/v2.0/token"
      logoutUrl: "https://nansendev2.b2clogin.com/NansenDEV2.onmicrosoft.com/B2C_1_signupsignin1/oauth2/v2.0/logout"

      # issuerUrl is REQUIRED (fail-closed verification). B2C needs two non-interchangeable urls:
      #   issuerUrl    — the `iss` B2C mints (tenant-GUID form). No metadata is served here.
      #   discoveryUrl — where the metadata lives (user-flow path).
      # Both verified against the live dev tenant.
      issuerUrl: "https://nansendev2.b2clogin.com/c87e0a28-0665-4f48-bf3b-a1060d182293/v2.0/"
      discoveryUrl: "https://nansendev2.b2clogin.com/NansenDEV2.onmicrosoft.com/B2C_1_signupsignin1/v2.0"

      # ChainFS storage — DEV, matching where the hub provisions subscriptions.
      apiBaseUrl: "https://nansendev.azurewebsites.net"

      # Every value above can be overridden per-deployment via FILEBROWSER_CHAINFS_{ISSUER,
      # DISCOVERY,LOGIN,TOKEN,LOGOUT}_URL and FILEBROWSER_CHAINFS_API_BASE_URL on the Container App.
    password:
      enabled: false
    oidc:
      enabled: false
    proxy:
      enabled: false
    noauth: false

userDefaults:
  defaultQuotaBytes: 4294967296  # 4 GB per user
  permissions:
    admin: false
    modify: true
    share: true
    delete: true
    create: true
    download: true
