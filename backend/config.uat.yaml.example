server:
  port: 8080
  baseURL: "/"
  sources:
    - path: "/srv"

auth:
  key: "__AUTH_KEY__"
  tokenExpirationHours: 4
  methods:
    chainfs:
      enabled: true
      apiBaseUrl: "https://nansenuat.azurewebsites.net"
      clientSecret: "__CHAINFS_CLIENT_SECRET__"
      createUser: true
      adminClaim: "roles"
      adminClaimValue: "admin"
      # Required for ID token signature verification; loginUrl is fetched from the ChainFS API at
      # runtime, so discoveryUrl cannot be derived and must be given explicitly.
      # NOTE: ChainFS storage here is UAT, but B2C is assumed to still be the DEV tenant (as it is
      # in prod). VERIFY before relying on interactive login in UAT — if UAT uses a different B2C
      # tenant/policy, these two values are wrong and logins will be refused:
      #   curl -s https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>/v2.0/.well-known/openid-configuration | jq .issuer
      issuerUrl: "https://nansendev2.b2clogin.com/c87e0a28-0665-4f48-bf3b-a1060d182293/v2.0/"
      discoveryUrl: "https://nansendev2.b2clogin.com/NansenDEV2.onmicrosoft.com/B2C_1_signupsignin1/v2.0"
    password:
      enabled: false
    oidc:
      enabled: false
    proxy:
      enabled: false
    noauth: false

userDefaults:
  permissions:
    admin: false
    modify: true
    share: true
    delete: true
    create: true
    download: true
